{
  "name": "@kazuph/mcp-browser-tabs",
  "version": "1.3.0",
  "description": "MCP server for managing Chrome browser tabs and native tab groups (tabs only — never cookies or sessions)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mcp-browser-tabs": "dist/index.js"
  },
  "files": [
    "dist",
    "extension",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazuph/mcp-browser-tabs.git"
  },
  "keywords": [
    "mcp",
    "browser",
    "chrome",
    "tabs",
    "tab-groups"
  ],
  "author": "kazuph",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "ws": "^8.18.0",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.33",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
